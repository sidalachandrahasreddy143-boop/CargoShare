# ─────────────────────────────────────────────────────────────
# CargoShare — environment configuration (copy to .env, fill in)
# Every variable documented. Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

# ---- PostgreSQL ----
POSTGRES_USER=cargoshare
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=cargoshare
DATABASE_URL=postgres://cargoshare:change_me_strong_password@db:5432/cargoshare

# ---- Redis (booking locks + cache + Socket.io adapter) ----
REDIS_URL=redis://redis:6379
# Booking lock TTL in seconds (10 minutes)
LOCK_TTL_SECONDS=600

# ---- MinIO (S3-compatible object storage) ----
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=cargoshare
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_ACCESS_KEY=cargoshare
MINIO_SECRET_KEY=change_me_minio_password
MINIO_BUCKET_DOCS=cargoshare-docs
MINIO_BUCKET_INVOICES=cargoshare-invoices
MINIO_BUCKET_CHAT=cargoshare-chat

# ---- Auth (custom JWT — no third-party auth SaaS) ----
# Generate: openssl rand -base64 48
JWT_SECRET=replace_with_64_char_random_secret
JWT_EXPIRES_IN=7d
OTP_TTL_SECONDS=300
# Optional: plug any SMS delivery API (MSG91 / Twilio / Fast2SMS). OTP logic is self-built.
SMS_API_KEY=
SMS_SENDER_ID=CRGOSH
SMS_API_URL=https://control.msg91.com/api/v5/flow

# ---- Payments: Razorpay sandbox (test mode first!) ----
# Get test keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
PLATFORM_COMMISSION_PCT=2.5

# ---- Transactional email (free-tier SMTP, e.g. Brevo / MailerSend) ----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CargoShare <no-reply@cargoshare.io>

# ---- Web Push (native, VAPID) — generate: npx web-push generate-vapid-keys ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@cargoshare.io

# ---- Web app ----
VITE_API_URL=http://localhost:4000

# ---- Monitoring ----
GRAFANA_PASSWORD=cargoshare-admin

# ---- App ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:8080
